{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "administratorName": {
      "value": "${SPRING_DATABASE_ADMIN_NAME=}"
    },
    "administratorObjectId": {
      "value": "${SPRING_DATABASE_ADMIN_OID=}"
    },
    "appImage": {
      "value": "${SERVICE_SPRING_PETCLINIC_REST_APP_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    },
    "databaseAuth": {
      "value": "password"
    },
    "databaseEngine": {
      "value": "postgresql"
    },
    "databaseName": {
      "value": "petclinic"
    },
    "databasePassword": {
      "value": "${SPRING_DATABASE_PASSWORD=}"
    },
    "driver": {
      "value": ""
    },
    "embeddedDriver": {
      "value": ""
    },
    "embeddedUrl": {
      "value": ""
    },
    "embeddedUrlConfigured": {
      "value": false
    },
    "environmentBindings": {
      "value": false
    },
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "foundryAuthentication": {
      "value": "apiKey"
    },
    "foundryDeploymentName": {
      "value": ""
    },
    "foundryEnabled": {
      "value": false
    },
    "foundryModelCapacity": {
      "value": 1
    },
    "foundryModelName": {
      "value": "gpt-5.6-sol"
    },
    "foundryModelSku": {
      "value": "GlobalStandard"
    },
    "foundryModelVersion": {
      "value": "2026-07-09"
    },
    "jdbcOptions": {
      "value": "sslmode=require"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "port": {
      "value": 9966
    },
    "profiles": {
      "value": [
        "postgres",
        "spring-data-jpa"
      ]
    },
    "serviceName": {
      "value": "spring-petclinic-rest-app"
    }
  }
}