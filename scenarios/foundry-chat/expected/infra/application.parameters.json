{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appImage": {
      "value": "${SERVICE_FOUNDRY_CHAT_APP_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    },
    "authentication": {
      "value": "password"
    },
    "databaseName": {
      "value": ""
    },
    "driver": {
      "value": ""
    },
    "embeddedDriver": {
      "value": ""
    },
    "embeddedUrl": {
      "value": ""
    },
    "embeddedUrlConfigured": {
      "value": false
    },
    "engine": {
      "value": "none"
    },
    "environmentBindings": {
      "value": false
    },
    "environmentId": {
      "value": "${SPRING_CONTAINER_APP_ENVIRONMENT_ID}"
    },
    "foundryAccountName": {
      "value": "${SPRING_FOUNDRY_ACCOUNT_NAME=}"
    },
    "foundryAuthentication": {
      "value": "apiKey"
    },
    "foundryDeploymentName": {
      "value": "gpt-5.4-nano"
    },
    "foundryEnabled": {
      "value": true
    },
    "host": {
      "value": "${SPRING_DATABASE_HOST=}"
    },
    "jdbcOptions": {
      "value": ""
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "password": {
      "value": "${SPRING_DATABASE_PASSWORD=}"
    },
    "port": {
      "value": 8080
    },
    "profiles": {
      "value": [
        "default"
      ]
    },
    "registryEndpoint": {
      "value": "${AZURE_CONTAINER_REGISTRY_ENDPOINT}"
    },
    "serviceName": {
      "value": "foundry-chat-app"
    },
    "username": {
      "value": "azdadmin"
    }
  }
}