{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appImage": {
      "value": "${SERVICE_SPRING_PETCLINIC_APP_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    },
    "authentication": {
      "value": "managedIdentity"
    },
    "databaseName": {
      "value": "petclinic"
    },
    "driver": {
      "value": ""
    },
    "embeddedDriver": {
      "value": ""
    },
    "embeddedUrl": {
      "value": ""
    },
    "embeddedUrlConfigured": {
      "value": false
    },
    "engine": {
      "value": "postgresql"
    },
    "environmentBindings": {
      "value": false
    },
    "environmentId": {
      "value": "${SPRING_CONTAINER_APP_ENVIRONMENT_ID}"
    },
    "foundryAccountName": {
      "value": "${SPRING_FOUNDRY_ACCOUNT_NAME=}"
    },
    "foundryDeploymentName": {
      "value": ""
    },
    "foundryEnabled": {
      "value": false
    },
    "host": {
      "value": "${SPRING_DATABASE_HOST=}"
    },
    "jdbcOptions": {
      "value": "authenticationPluginClassName=com.azure.identity.extensions.jdbc.postgresql.AzurePostgresqlAuthenticationPlugin\u0026azure.managedIdentityEnabled=true\u0026sslmode=verify-full\u0026sslrootcert=%2Fetc%2Fssl%2Fcerts%2Fca-certificates.crt"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "password": {
      "value": "${SPRING_DATABASE_PASSWORD=}"
    },
    "port": {
      "value": 8080
    },
    "profiles": {
      "value": [
        "postgres-managed-identity"
      ]
    },
    "registryEndpoint": {
      "value": "${AZURE_CONTAINER_REGISTRY_ENDPOINT}"
    },
    "serviceName": {
      "value": "spring-petclinic-app"
    },
    "username": {
      "value": "azd_app"
    }
  }
}