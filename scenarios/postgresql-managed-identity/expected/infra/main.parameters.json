{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "administratorName": {
      "value": "${SPRING_DATABASE_ADMIN_NAME=}"
    },
    "administratorObjectId": {
      "value": "${SPRING_DATABASE_ADMIN_OID=}"
    },
    "appImage": {
      "value": "${SERVICE_SPRING_PETCLINIC_APP_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    },
    "databaseAuth": {
      "value": "managedIdentity"
    },
    "databaseEngine": {
      "value": "postgresql"
    },
    "databaseName": {
      "value": "petclinic"
    },
    "databasePassword": {
      "value": "${SPRING_DATABASE_PASSWORD=}"
    },
    "driver": {
      "value": ""
    },
    "embeddedDriver": {
      "value": ""
    },
    "embeddedUrl": {
      "value": ""
    },
    "embeddedUrlConfigured": {
      "value": false
    },
    "environmentBindings": {
      "value": false
    },
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "foundryDeploymentName": {
      "value": ""
    },
    "foundryEnabled": {
      "value": false
    },
    "foundryModelCapacity": {
      "value": 1
    },
    "foundryModelName": {
      "value": "gpt-5.4-nano"
    },
    "foundryModelSku": {
      "value": "GlobalStandard"
    },
    "foundryModelVersion": {
      "value": "2026-03-17"
    },
    "jdbcOptions": {
      "value": "authenticationPluginClassName=com.azure.identity.extensions.jdbc.postgresql.AzurePostgresqlAuthenticationPlugin\u0026azure.managedIdentityEnabled=true\u0026sslmode=verify-full\u0026sslrootcert=%2Fetc%2Fssl%2Fcerts%2Fca-certificates.crt"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "port": {
      "value": 8080
    },
    "profiles": {
      "value": [
        "postgres-managed-identity"
      ]
    },
    "serviceName": {
      "value": "spring-petclinic-app"
    }
  }
}