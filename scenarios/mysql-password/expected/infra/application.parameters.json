{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appImage": {
      "value": "${SERVICE_SPRING_PETCLINIC_APP_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    },
    "authentication": {
      "value": "password"
    },
    "databaseName": {
      "value": "petclinic"
    },
    "engine": {
      "value": "mysql"
    },
    "environmentId": {
      "value": "${SPRING_CONTAINER_APP_ENVIRONMENT_ID}"
    },
    "host": {
      "value": "${SPRING_DATABASE_HOST=}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "password": {
      "value": "${SPRING_DATABASE_PASSWORD=}"
    },
    "port": {
      "value": 8080
    },
    "profiles": {
      "value": [
        "mysql"
      ]
    },
    "registryEndpoint": {
      "value": "${AZURE_CONTAINER_REGISTRY_ENDPOINT}"
    },
    "serviceName": {
      "value": "spring-petclinic-app"
    },
    "username": {
      "value": "azdadmin"
    }
  }
}