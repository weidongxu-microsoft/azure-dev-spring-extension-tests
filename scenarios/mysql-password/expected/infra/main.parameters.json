{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "administratorName": {
      "value": "${SPRING_DATABASE_ADMIN_NAME=}"
    },
    "administratorObjectId": {
      "value": "${SPRING_DATABASE_ADMIN_OID=}"
    },
    "appImage": {
      "value": "${SERVICE_SPRING_PETCLINIC_APP_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    },
    "applicationSecrets": {
      "value": {}
    },
    "applicationValues": {
      "value": {}
    },
    "databaseAuth": {
      "value": "password"
    },
    "databaseEngine": {
      "value": "mysql"
    },
    "databaseName": {
      "value": "petclinic"
    },
    "databasePassword": {
      "value": "${SPRING_DATABASE_PASSWORD=}"
    },
    "driver": {
      "value": ""
    },
    "embeddedDriver": {
      "value": ""
    },
    "embeddedUrl": {
      "value": ""
    },
    "embeddedUrlConfigured": {
      "value": false
    },
    "environmentBindings": {
      "value": false
    },
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "foundryAuthentication": {
      "value": "apiKey"
    },
    "foundryChatDeploymentName": {
      "value": ""
    },
    "foundryChatEnabled": {
      "value": false
    },
    "foundryChatModelCapacity": {
      "value": 1
    },
    "foundryChatModelName": {
      "value": "gpt-5.6-sol"
    },
    "foundryChatModelSku": {
      "value": "GlobalStandard"
    },
    "foundryChatModelVersion": {
      "value": "2026-07-09"
    },
    "foundryEmbeddingDeploymentName": {
      "value": ""
    },
    "foundryEmbeddingEnabled": {
      "value": false
    },
    "foundryEmbeddingModelCapacity": {
      "value": 1
    },
    "foundryEmbeddingModelName": {
      "value": "text-embedding-3-small"
    },
    "foundryEmbeddingModelSku": {
      "value": "GlobalStandard"
    },
    "foundryEmbeddingModelVersion": {
      "value": "1"
    },
    "foundryEnabled": {
      "value": false
    },
    "jdbcOptions": {
      "value": "requireSSL=true\u0026sslMode=REQUIRED\u0026useSSL=true\u0026verifyServerCertificate=false"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "port": {
      "value": 8080
    },
    "profiles": {
      "value": [
        "mysql"
      ]
    },
    "serviceName": {
      "value": "spring-petclinic-app"
    }
  }
}